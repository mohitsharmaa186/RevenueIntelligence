<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Must_Be_Greater_Than_Zero</fullName>
    <active>true</active>
    <description>Opportunity Amount must be greater than 0.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Amount)), Amount &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Amount</errorDisplayField>
    <errorMessage>Opportunity Amount must be greater than 0.</errorMessage>
</ValidationRule>
